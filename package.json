{
  "name": "filesaver-modern",
  "version": "3.0.1",
  "description": "file-saver alternative: saveAs() for Blob/File, with working iOS + Chromium support. Same API, zero deps.",
  "main": "dist/FileSaver.js",
  "module": "dist/FileSaver.mjs",
  "types": "dist/FileSaver.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/FileSaver.d.ts",
      "import": "./dist/FileSaver.mjs",
      "require": "./dist/FileSaver.js",
      "default": "./dist/FileSaver.js"
    },
    "./package.json": "./package.json"
  },
  "browser": "dist/FileSaver.js",
  "unpkg": "dist/FileSaver.js",
  "jsdelivr": "dist/FileSaver.js",
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/FileSaver.test.js",
    "test:browser": "node serve.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "file-saver",
    "filesaver",
    "saveAs",
    "save-as",
    "file saver",
    "filesaver.js",
    "saveAs.js",
    "blob",
    "download",
    "file-download",
    "save-file",
    "client-side",
    "browser",
    "ios",
    "safari",
    "iphone",
    "chrome",
    "chromium",
    "showSaveFilePicker",
    "file-system-access-api",
    "web-share-api",
    "export-csv",
    "export-pdf",
    "export-excel",
    "export-json",
    "save-image",
    "download-file",
    "blob-url",
    "object-url",
    "utf8-bom",
    "excel",
    "csv-export",
    "no-dependencies",
    "drop-in-replacement",
    "file-saver-alternative"
  ],
  "author": "kralkorki",
  "contributors": [
    "Eli Grey <http://eligrey.com> (original author of FileSaver.js)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kralkorki/filesaver-modern.git"
  },
  "bugs": {
    "url": "https://github.com/kralkorki/filesaver-modern/issues"
  },
  "homepage": "https://github.com/kralkorki/filesaver-modern#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {},
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kralkorki"
  }
}
